# ============================================================
# bMS 人事・売上統合システム 環境変数テンプレート
# ============================================================
# 実際の値を .env ファイルにコピー＆編集してください
# .env ファイルは Git にコミットしてはいけません
# サーバへは FTP で .env を手動アップロードしてください
# ============================================================

# --- データベース ---
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4

# --- アプリケーション ---
APP_NAME=bMS - タレントマネジメントシステム
APP_VERSION=1.0.0
BASE_PATH=/bms

# --- デバッグ設定 (本番は false) ---
DEBUG_MODE=false

# --- FTP デプロイ (deploy_ftp.py で使用) ---
FTP_HOST=sv904.xbiz.ne.jp
FTP_USER=your_ftp_user
FTP_PASS=your_ftp_password
FTP_REMOTE_BASE=/your_domain/public_html/bms

# --- Googleドライブ連携（取引先一覧の契約書。未設定でもアプリは正常に動作します） ---
# 下記はいずれか1つを設定してください。非公開の契約書を開くにはサービスアカウントが必要です。
#
# 1) サービスアカウント（推奨・非公開ファイル対応）
#    JSONの中身をそのまま、またはJSONファイルの絶対パスを指定
#    ※対象フォルダをサービスアカウントのメールアドレスに共有してください
GOOGLE_SERVICE_ACCOUNT_JSON=
# 契約書を格納するドライブのフォルダID（任意）
GOOGLE_DRIVE_FOLDER_ID=
#
# 2) OAuth2（自分のGoogleアカウントのドライブを使う場合）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
#
# 3) APIキーのみ（公開ファイル限定。非公開の契約書には使えません）
GOOGLE_API_KEY=
